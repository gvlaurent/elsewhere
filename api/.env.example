# Variables d'environnement de l'API Elsewhere.
# Copier ce fichier en .env, puis adapter les valeurs. Ne jamais versionner .env.

# Port sur lequel l'API écoute (3000 par défaut).
PORT=3000

# Adresse de la base PostgreSQL chez Supabase : Connect → Session pooler.
# Le pooler en mode « session » (port 5432) est joignable en IPv4 et accepte
# les réglages par connexion dont les tests ont besoin. Remplacer
# [YOUR-PASSWORD] par le mot de passe de la base. Sans « ?sslmode=… » :
# le chiffrement se règle avec DATABASE_CA_CERT ci-dessous.
# Sans cette variable, les tests qui touchent la base sont sautés.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Chemin du certificat de Supabase (Project Settings → Database → SSL
# Configuration → Download certificate), relatif au dossier api/. Il permet
# de vérifier qu'on parle bien à Supabase. Public, ce n'est pas un secret.
# Inutile pour une base sur localhost.
DATABASE_CA_CERT=certs/supabase-ca.crt
